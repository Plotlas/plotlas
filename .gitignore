# Opt-in local HTTPS certs (docker/certs) — never commit certs/keys; keep the dir.
docker/certs/*
!docker/certs/.gitkeep

# vite dependency pre-bundle cache (build artifact)
.vite/

# Playwright e2e artifacts (real-browser renderer diagnostics)
test-results/
playwright-report/
.last-run.json

# Ingested collections + the app-state DB (bind-mounted at ${DATA_DIR:-./data}).
# The folders and their .gitkeep files are tracked so a fresh clone has the mount
# points; the contents never are — they are datasets, not source.
#
# datasets/ and appstate/ MUST be tracked, not just data/. Docker chowns an empty
# NAMED VOLUME to the container's user on first use, but never does that for a bind
# mount: if these do not exist in the mount, the daemon creates them itself as
# root:root 755 (to hold the fixture mount points), and the api/worker — which run
# as uid 10001, not root — then cannot write. That surfaced as `PermissionError:
# /data/datasets/.staging-<job>` on the first upload after the bind-mount switch,
# i.e. on the exact path a new self-hoster takes.
/data/*
!/data/.gitkeep
!/data/datasets/
/data/datasets/*
!/data/datasets/.gitkeep
!/data/app-state/
/data/app-state/*
!/data/app-state/.gitkeep

# Scratch directories the stdlib test suites under scripts/ make INSIDE the work tree
# (they resolve paths against the repository root, as production does). A case killed
# before its cleanup -- Ctrl-C, a gate's bound, an agent's limit -- leaves one behind,
# and some hold a nested `.git`: unignored, `git add -A` commits it as an embedded
# repository. scripts/docstate/test_probe.py reads every suite's `mkdtemp(...,
# dir=ROOT)` prefix and fails if one is missing here.
/check-test-*/
/daily-test-*/
/docstate-items-*/
/docstate-out-*/
/docstate-probe-*/
/docstate-test-*/
/docstate-upstream-*/
/status-test-*/
