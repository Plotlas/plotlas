# Plotlas — public showcase deployment secrets (Seam H1, RELEASE_READINESS §2).
#
# Copy to `.env` ON THE DEPLOY HOST and fill in the real values. The real `.env`
# is git-ignored (see .gitignore) and must NEVER be committed. It is generated on
# the host, not shipped.
#
#     cp .env.example .env
#     # then set JWT_SECRET (and ACME_EMAIL) below
#
# docker-compose.public.yml loads this file via `env_file: .env` on both the api
# and caddy services (a plain shell `export` would NOT reach the containers). The
# three security values below ACTIVATE the API's dormant fail-closed production
# guards: a missing / dev-fallback / <32-char JWT_SECRET, or a wildcard (or
# blank) ALLOWED_ORIGINS, makes the api crash-loop at boot instead of serving
# insecurely. That is intentional — a misconfigured deploy must fail loudly.

# Marks a production deployment: turns ON the fail-closed JWT_SECRET + CORS guards
# (api.appstate._is_production). Keep this `production` for the public host.
APP_ENV=production

# HS256 signing secret for the identity-only JWT. MUST be a strong random value,
# at least 32 characters; the source-visible dev fallback and any short value are
# REFUSED in production. Generate one on the host and paste it here:
#     openssl rand -base64 48
JWT_SECRET=

# Explicit CORS allow-list (comma-separated). A wildcard `*` (or blank) is REFUSED
# in production. For the showcase this is the single app origin.
ALLOWED_ORIGINS=https://app.plotlas.com

# Optional: identity-token lifetime in seconds (default 86400 = 24h). If set it
# must be a positive integer; a malformed value crash-loops the boot.
# JWT_TTL_SECONDS=86400

# ACME account email for Caddy's automatic HTTPS (Let's Encrypt): expiry /
# renewal notices, and the address on the ACME account. REQUIRED for the public
# edge — the caddy service reads it via ${ACME_EMAIL:?...}, so a blank/unset value
# makes `docker compose -f docker-compose.public.yml up` FAIL FAST with a clear
# message (not an opaque Caddy parse crash). Set a real inbox you monitor:
ACME_EMAIL=

# --- Deployment expectations (informational — set inside the compose, not here) --
# Content and app-state are BIND MOUNTS under ${DATA_DIR:-./data} on the host, not
# Docker named volumes (changed by PR #234 so `docker compose down -v` can no longer
# destroy either). DATA_DIR is the one knob for where they live; point it at another
# path or a mounted disk if you outgrow the default. Inside the containers:
#     api   -> /data           ({DATA_DIR}, mounted READ-ONLY; trees at /data/datasets/)
#     caddy -> /srv/datasets   (same path, read-only; serves {DATA_DIR}/datasets/)
# The api's mutable app-state SQLite (user accounts + dataset ownership, incl.
# password hashes) is disjoint from that read-only content, at
# APP_STATE_DB=/app-state/appstate.db, backed by {DATA_DIR}/app-state on the host.
# Because /data is read-only here, populate collections OUT OF BAND — untar them
# into {DATA_DIR}/datasets/ on the host, NOT through `docker compose exec api`
# (that write fails: read-only file system). See RELEASE_READINESS.md §4.
# Published host ports: 80 (ACME HTTP-01 challenge + the http->https redirect)
# and 443 (HTTPS). Point app.plotlas.com's DNS A record at this host and keep both
# ports reachable — and if the DNS is behind Cloudflare, it MUST be DNS-only (grey
# cloud): a proxy intercepts :80 and breaks the ACME HTTP-01 challenge, and serving
# the imagery through the CDN from a non-Cloudflare origin is restricted by their
# terms. See docs/launch/HOSTING_RESEARCH.md §5.
