{
  "name": "@image-viz/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
    "gen:check": "node scripts/gen-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "perf": "vite --config perf/vite.config.ts",
    "perf:build": "vite build --config perf/vite.config.ts",
    "test": "node --import ./tests/dom/ts-extension-resolver.mjs --test --experimental-strip-types tests/*.test.ts",
    "test:dom": "node --no-experimental-webstorage --import global-jsdom/register --import ./tests/dom/ts-extension-resolver.mjs --test --experimental-strip-types tests/dom/*.dom.test.ts"
  },
  "dependencies": {
    "apache-arrow": "^21.2.0",
    "pmtiles": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "global-jsdom": "^25.0.0",
    "jsdom": "^25.0.0",
    "json-schema-to-typescript": "^15.0.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
